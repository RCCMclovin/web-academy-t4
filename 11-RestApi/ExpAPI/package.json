{
  "name": "expapi",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "nodemon ./src/index.ts --watch ./src",
    "start:prod": "node ./build/index.js",
    "lint": "npx eslint src/",
    "lint:fix": "npx eslint --fix src/",
    "prettier": "npx prettier src --check",
    "prettier:fix": "npm run prettier -- --write",
    "migrate": "npx prisma migrate dev --name init",
    "format": "npm run prettier:fix src/ && npm run lint:fix src/",
    "build": "npx tsc",
    "swagger": "ts-node src/swagger.ts"
  },
  "keywords": [],
  "author": "Rafael Castilho Carvalho",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.7.5",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "nodemon": "^3.1.7",
    "prettier": "3.3.3",
    "prisma": "^5.21.1",
    "swagger-autogen": "^2.23.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  }
}